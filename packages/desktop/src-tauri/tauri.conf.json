{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Takalif",
  "version": "0.1.0",
  "identifier": "com.takalif.desktop",
  "build": {
    "frontendDist": "../sidecar-build/resources/web",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "node scripts/fetch-sidecar.mjs"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Takalif",
        "url": "http://127.0.0.1:8787",
        "width": 1200,
        "height": 800,
        "minWidth": 360,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/node"
    ],
    "resources": {
      "../sidecar-build/resources/server": "server",
      "../sidecar-build/resources/web": "web"
    }
  }
}
